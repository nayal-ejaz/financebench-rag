# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Third-party raw data: download with scripts/download_data.py ---
# Commit data/manifest.json only, unless the FinanceBench licence (D2.1) allows otherwise.
data/raw/
data/processed/

# --- Build output and caches ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Model weights and local indexes (rebuilt or baked into Docker) ---
*.npy
models/

# --- Editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Notebooks: keep only cleared notebooks ---
.ipynb_checkpoints/
